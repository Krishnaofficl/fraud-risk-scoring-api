# Server Configuration
PROJECT_NAME="Fraud & Risk Scoring API"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL with asyncpg driver)
# Note: Cloud hosts often provide postgres://, which the app automatically normalizes to postgresql+asyncpg://
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fraud_db"

# Security & JWT
JWT_SECRET="change-this-to-a-secure-random-32-byte-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Artifacts
MODEL_PATH="artifacts/model_pipeline.joblib"
MODEL_VERSION="v1-baseline"
